{# @var cart \craft\commerce\elements\Order #}
{% set cart = craft.commerce.carts.cart %}

{# @var variant \craft\commerce\elements\Variant #}
{% set variant = craft.variants()
    .id(variantId)
    .one()
%}

<div class="product flex p-2">
    <div class="flex-shrink-0">
        {% set image = variant.owner.image.eagerly().one() %}
        {% if image %}
            <img src="{{ image.url }}" alt="{{ image.title }}" class="h-24 w-24 rounded-md object-cover object-center sm:h-36 sm:w-36"/>
        {% endif %}
    </div>
    <div class="ml-4 flex flex-1 flex-col justify-between sm:ml-6">
        <div class="relative pr-9 sm:grid sm:grid-cols-2 sm:gap-x-6 sm:pr-0">
            <div>
                <div class="flex justify-between">
                    <h3 class="text-md">
                        <a class="font-medium text-gray-700 hover:text-gray-800">
                            {{ variant.title }}
                        </a>
                    </h3>
                </div>
                <p class="mt-1 text-md font-medium text-gray-900">
                    {{ variant.priceAsCurrency }}
                </p>
                <div class="mt-4 sm:pr-9">
                    {% if variant.availableForPurchase %}
                        <button disabled class="rounded-md border border-transparent bg-green-700 px-2 text-base font-medium text-white shadow-sm hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-600 focus:ring-offset-2 focus:ring-offset-gray-50">
                            Available
                        </button>
                    {% else %}
                        <button disabled class="rounded-md border border-transparent bg-gray-600 px-2 text-base font-medium text-white shadow-sm hover:bg-gray-600 focus:outline-none focus:ring-2 focus:ring-gray-500 focus:ring-offset-2 focus:ring-offset-gray-50">
                            Unavailable
                        </button>
                    {% endif %}
                </div>
            </div>
            {% if variant.availableForPurchase %}
                <form sprig s-method="post" s-action="commerce/cart/update-cart" s-val:purchasable-id="{{ variant.id }}">
                    <div class="mt-4 sm:mt-0">
                        <div class="flex justify-between">
                            <select name="qty" class="form-select max-w-full rounded-md border border-gray-300 py-1.5 text-left text-base font-medium leading-5 text-gray-700 shadow-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 sm:text-md">
                                {% set qty = qty ?? null %}
                                {% for i in 1..8 %}
                                    <option value="{{ i }}" {{ i == qty ? 'selected' }}>{{ i }}</option>
                                {% endfor %}
                            </select>
                            {% if variant.id in cart.lineItems|map(item => item.purchasable.id) %}
                                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-8 text-gray-300"><path d="M2.25 2.25a.75.75 0 0 0 0 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 0 0-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 0 0 0-1.5H5.378A2.25 2.25 0 0 1 7.5 15h11.218a.75.75 0 0 0 .674-.421 60.358 60.358 0 0 0 2.96-7.228.75.75 0 0 0-.525-.965A60.864 60.864 0 0 0 5.68 4.509l-.232-.867A1.875 1.875 0 0 0 3.636 2.25H2.25ZM3.75 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM16.5 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" /></svg>
                            {% endif %}
                        </div>
                        <div class="flex mt-4 space-x-1">
                            <button type="submit" class="rounded-md border border-transparent bg-sky-700 px-2 py-1 text-base font-medium text-white shadow-sm hover:bg-sky-700 focus:outline-none focus:ring-2 focus:ring-sky-600 focus:ring-offset-2 focus:ring-offset-gray-50">
                                Add to Cart
                            </button>
                            {% set purchasableId = purchasableId ?? null %}
                            <svg id="variant-check-{{ variant.id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6 text-green-700 mt-1 transition-opacity duration-1000 {{ purchasableId != variant.id ? 'opacity-0' }}"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12Zm13.36-1.814a.75.75 0 1 0-1.22-.872l-3.236 4.53L9.53 12.22a.75.75 0 0 0-1.06 1.06l2.25 2.25a.75.75 0 0 0 1.14-.094l3.75-5.25Z" clip-rule="evenodd" /></svg>
                            {% if purchasableId == variant.id %}
                                <script>
                                    setTimeout(() => {
                                        htmx.addClass('#variant-check-{{ variant.id }}', 'opacity-0');
                                    }, 1000);
                                </script>
                            {% endif %}
                        </div>
                    </div>
                </form>
            {% endif %}
        </div>
    </div>
</div>

{#{% if sprig.isRequest %}#}
{#    <script>#}
{#        htmx.trigger('#summary', 'refresh');#}
{#        htmx.trigger('#cart', 'refresh');#}
{#    </script>#}
{#{% endif %}#}

{#{% do sprig.triggerRefresh('#summary') %}#}
{#{% do sprig.triggerRefresh('#cart') %}#}

{#{% do sprig.swapOob('#summary', '_components/summary') %}#}
