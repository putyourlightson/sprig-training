{# @var productQuery \craft\commerce\elements\db\ProductQuery #}
{% set variantQuery = craft.variants %}
{% if price ?? null %}
    {% do variantQuery.price('<' ~ price) %}
{% endif %}
{% if available ?? null %}
    {% do variantQuery.availableForPurchase(true) %}
{% endif %}
{% set variantIds = variantQuery.ids() %}

{% set categoriesLevel1 = craft.categories
    .group('products')
    .level(1)
    .all()
%}
{% if categoryLevel1Id ?? null %}
    {% set categoriesLevel2 = craft.categories
        .group('products')
        .level(2)
        .descendantOf(categoryLevel1Id)
        .all()
    %}
{% endif %}

<div class="flex pb-4 mb-4 border-b">
    <select sprig name="categoryLevel1Id" class="form-select mr-3 rounded-md border border-gray-300 text-left text-base font-medium leading-5 text-gray-700 shadow-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 sm:text-md">
        <option value="">All categories</option>
        {% for category in categoriesLevel1 %}
            {% set productCount = craft.products.relatedTo(category).count() %}
            {% if productCount > 0 %}
                <option value="{{ category.id }}" {{ categoryLevel1Id ?? null == category.id ? 'selected' }}>
                    {{ category.title }}
                    ({{ productCount }})
                </option>
            {% endif %}
        {% endfor %}
    </select>
    {% if categoryLevel1Id ?? null %}
        <select sprig name="categoryLevel2Id" class="form-select mr-3 rounded-md border border-gray-300 text-left text-base font-medium leading-5 text-gray-700 shadow-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 sm:text-md">
            <option value="">All categories</option>
            {% for category in categoriesLevel2 %}
                {% set productCount = craft.products.relatedTo(category).count() %}
                {% if productCount > 0 %}
                    <option value="{{ category.id }}" {{ categoryLevel2Id ?? null == category.id ? 'selected' }}>
                        {{ category.title }}
                        ({{ productCount }})
                    </option>
                {% endif %}
            {% endfor %}
        </select>
    {% endif %}
    <select sprig name="price" class="form-select mr-3 rounded-md border border-gray-300 text-left text-base font-medium leading-5 text-gray-700 shadow-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 sm:text-md">
        <option value="">All prices</option>
        <option value="20" {{ price ?? null == 20 ? 'selected' }}>< $20</option>
        <option value="50" {{ price ?? null == 50 ? 'selected' }}>< $50</option>
        <option value="100" {{ price ?? null == 100 ? 'selected' }}>< $100</option>
    </select>
    <select sprig name="available" class="form-select mr-3 rounded-md border border-gray-300 text-left text-base font-medium leading-5 text-gray-700 shadow-sm focus:border-sky-600 focus:outline-none focus:ring-1 focus:ring-sky-600 sm:text-md">
        <option value="">All availability</option>
        <option value="1" {{ available ?? null == 1 ? 'selected' }}>Only available</option>
    </select>
</div>
<section id="results" aria-labelledby="cart-heading" class="min-w-[42rem]">
    <h2 id="cart-heading" class="sr-only">Items in your shopping cart</h2>
    <div class="space-y-4">
        {% if variantIds|length %}
            {% for variantId in variantIds %}
                {{ sprig('_components/product', { variantId: variantId }) }}
            {% endfor %}
        {% else %}
            <div class="flex p-4">
                No products found
            </div>
        {% endif %}
    </div>
</section>
